{
  "name": "eims-prosystem-kenya",
  "version": "2.0.0",
  "description": "African Merchant Assurance Company (AMACO) - County Government Enterprise Insurance Management System (EIMS)",
  "private": true,
  "scripts": {
    "serve": "npx -y firebase-tools@latest serve --port 8282",
    "dev": "npx -y firebase-tools@latest emulators:start",
    "deploy": "npx -y firebase-tools@latest deploy",
    "deploy:hosting": "npx -y firebase-tools@latest deploy --only hosting",
    "deploy:firestore": "npx -y firebase-tools@latest deploy --only firestore",
    "check": "node check-ui.js && node check-render.js",
    "seed": "node seed-firestore.mjs",
    "check:rules": "node functions/check-rules.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "firebase": "^10.12.0"
  },
  "devDependencies": {
    "firebase-tools": "^13.12.0",
    "puppeteer-core": "^25.8.0",
    "firebase-admin": "^12.6.0"
  }
}
