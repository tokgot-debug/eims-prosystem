rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Claims carry claimant names, phone numbers, GPS coordinates and
    // settlement amounts. Reads require a signed-in staff member -- these were
    // world-readable (`allow read: if true`), which published claimant PII to
    // anyone who knew the project id.
    match /claims/{claimId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.vehicle is string
        && request.resource.data.vehicle.size() <= 20;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /policies/{policyNo} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Certificates are the one thing a member of the public may legitimately
    // read unauthenticated: the AKI verification page checks a certificate by
    // its id. They hold no claimant contact details or amounts, and nobody
    // outside the portal may write one.
    match /certificates/{certId} {
      allow read: if true;
      allow write: if false;
    }

    match /notification_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /work_orders/{orderId} {
      allow read, create, update: if isAuthenticated();
    }

    match /user_seats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
